# Legado JWT: gere um valor forte e único para cada ambiente.
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria
# Opcional; padrão: 1h
JWT_EXPIRES_IN=1h

# PostgreSQL/Supabase. Nunca versione a URL real do banco.
DATABASE_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres
# O Supabase exige TLS; use false somente no Postgres local.
DATABASE_SSL=true

# Administração da API multi-aluno. Gere valores longos e aleatórios.
ADMIN_SECRET=troque-por-um-segredo-administrativo-longo-e-aleatorio
API_KEY_PEPPER=troque-por-um-segredo-para-hash-das-api-keys

# Configurações HTTP
PORT=3000
CORS_ORIGIN=*
LOGIN_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=5
